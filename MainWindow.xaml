<Window x:Class="NeuralNet_WPF_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neurális Háló Szimulátor" Height="550" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="StartBtn" Content="Tanítás Indítása" Click="StartBtn_Click" Width="120" Margin="0,0,10,0" Background="#2196F3" Foreground="White"/>
            <TextBlock Text="Keresés a múltbeli adatokban:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox x:Name="SearchBox" Width="150" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Folyamat követése és Előzmények" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Élő Napló (Observer):" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox x:Name="LogList" Height="80" Margin="0,0,0,10"/>

                    <TextBlock Text="Adatbázis Előzmények (Szöveges):" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox x:Name="PreviousResults" Height="80"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Hibaarány Alakulása (Grafikon):" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Border BorderBrush="Gray" BorderThickness="1" Height="170" Background="#F9F9F9">
                        <Canvas x:Name="ChartCanvas" Height="168" Width="360" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                    <TextBlock Text="Kék: MSE | Piros: MAE | Zöld: BCE" FontSize="10" Foreground="Gray" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="2" Text="Mentett eredmények (CRUD):" FontWeight="Bold" Margin="0,5"/>

        <DataGrid Grid.Row="3" x:Name="HistoryGrid" 
          AutoGenerateColumns="False" 
          VerticalScrollBarVisibility="Auto"
          SelectionMode="Single" 
          SelectionUnit="FullRow"
          IsReadOnly="True"
          IsSynchronizedWithCurrentItem="True"
          Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="40"/>
                <DataGridTextColumn Header="Időpont" Binding="{Binding Timestamp}" Width="110"/>
                <DataGridTextColumn Header="Stratégia" Binding="{Binding Strategy}" Width="*"/>
                <DataGridTextColumn Header="Tanulási Ráta" Binding="{Binding LearningRate, StringFormat=\{0:F4\}}" Width="95"/>
                <DataGridTextColumn Header="Hiba (Loss)" Binding="{Binding Result, StringFormat=\{0:F6\}}" Width="100"/>
                <DataGridTextColumn Header="Pontosság (%)" Binding="{Binding Accuracy, StringFormat=\{0:P2\}}" Width="100" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UpdateBtn" Content="Módosítás" Click="UpdateBtn_Click" Margin="0,0,10,0" Width="80"/>
            <Button x:Name="DeleteBtn" Content="Törlés" Click="DeleteBtn_Click" Background="#FF5733" Foreground="White" Width="80"/>
            <Button x:Name="PreviousBtn" Content="Előzőek betöltése" Click="PreviousBtn_Click" Width="120" Margin="0,0,10,0" Background="#2196F3" Foreground="White"/>
        </StackPanel>

    </Grid>
</Window>
