<Window x:Class="NeuralNet_WPF_UI.Parameters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hiperparaméterek Beállítása" Height="350" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Neurális Háló Konfiguráció" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" HorizontalAlignment="Center" Foreground="#2196F3"/>
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Hiba kalkuláció módja:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="StrategyCombo" SelectedIndex="0" Padding="3">
                    <ComboBoxItem Content="BCE (Binary Cross-Entropy)"/>
                    <ComboBoxItem Content="MSE (Mean Squared Error)"/>
                    <ComboBoxItem Content="MAE (Mean Absolute Error)"/>
                </ComboBox>
            </Grid>
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Ciklusok száma (Epochs):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="EpochsBox" Text="10" HorizontalContentAlignment="Center" Padding="3"/>
            </Grid>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tanulási ráta (LR):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="LrBox" Text="0.01" HorizontalContentAlignment="Center" Padding="3"/>
            </Grid>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Bemeneti neuronok száma:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="InputNeuronsBox" Text="8" HorizontalContentAlignment="Center" Padding="3"/>
            </Grid>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Rejtett neuronok száma:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="HiddenNeuronsBox" Text="16" HorizontalContentAlignment="Center" Padding="3"/>
            </Grid>

            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Kimeneti neuronok száma:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="OutputNeuronsBox" Text="1" HorizontalContentAlignment="Center" Padding="3"/>
            </Grid>
        </StackPanel>

        <Button Grid.Row="1" x:Name="SaveBtn" Content="Mentés és Tanítás Indítása" Click="SaveBtn_Click" 
                Padding="10,8" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,15,0,0"/>
    </Grid>
</Window>